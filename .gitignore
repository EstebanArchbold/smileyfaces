node_modules/
.npm/

# ─── Builds ───────────────────────────────────────────────────────────────────
dist/
backend/dist/
frontend/dist/

# ─── Variables de entorno (NUNCA subir al repo) ────────────────────────────────
.env
*.env.local

# ─── Secretos / scripts locales ───────────────────────────────────────────────

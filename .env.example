# =============================================================
# smileyfaces - variables de entorno
# Copia este archivo a .env y rellena con tus valores reales.
# NUNCA subas .env a git.
# =============================================================

# Password del usuario 'smileyfaces' en Postgres.
# DEBE coincidir con SMILEYFACES_DB_PASSWORD del stack infra.
SMILEYFACES_DB_PASSWORD=cambiame-mismo-valor-que-en-infra

# Secreto para firmar tokens JWT.
# Generalo con: openssl rand -base64 32
JWT_SECRET=cambiame-genera-uno-fuerte

# Credenciales del admin del sitio.
# El password hash se genera con bcrypt. Ejemplo para 'admin123':
#   docker run --rm -ti node:20-alpine sh -c "npm i -g bcryptjs-cli 2>/dev/null; node -e \"console.log(require('bcryptjs').hashSync('TU-PASSWORD', 10))\""
# O usá el hash de ejemplo (NO USAR EN PRODUCCION):
ADMIN_EMAIL=admin@smileyfaces.com
ADMIN_PASSWORD_HASH=$2a$10$TC/etrLGoZk1ZjhqZOAYhOlosz59Qlplh/3TUxPW0gs/atGaVw0QW
